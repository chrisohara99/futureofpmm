<?xml version="1.0" encoding="UTF-8"?>
<!-- IMS Metadata Specification v1.2.1 - Minimal Schema for SCORM 1.2 -->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns="http://www.imsglobal.org/xsd/imsmd_rootv1p2p1"
            targetNamespace="http://www.imsglobal.org/xsd/imsmd_rootv1p2p1"
            elementFormDefault="qualified"
            version="IMS MD 1.2.1">
    <xsd:element name="lom" type="lomType"/>
    <xsd:complexType name="lomType">
        <xsd:sequence>
            <xsd:element name="general" type="generalType" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="generalType">
        <xsd:sequence>
            <xsd:element name="title" type="xsd:string" minOccurs="0"/>
            <xsd:element name="description" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>
</xsd:schema>
