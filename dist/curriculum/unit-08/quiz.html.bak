</header>
    
    <section class="hero">
        <h1>Unit 8 Assessment</h1>
        <p>Pricing & Packaging in the Agent Era • 4 exercises • ~15 minutes</p>
    </section>
    
    <main>
        <div class="assessment-intro">
            <p>This assessment tests your ability to <strong>apply</strong> pricing concepts. Tap items to select, then tap zones to place them.</p>
            <div class="scoring-info">
                <div><span>🎯</span> 100 points total</div>
                <div><span>✅</span> 80+ to pass</div>
                <div><span>💰</span> Pricing Mastery</div>
            </div>
        </div>
        
        <!-- Exercise 1: Sort Characteristics to Pricing Models -->
        <div class="exercise" id="exercise1">
            <div class="exercise-header">
                <div>
                    <div class="exercise-number">Exercise 1 of 4</div>
                    <div class="exercise-title">Pricing Model Characteristics</div>
                </div>
                <div class="exercise-points">30 points</div>
            </div>
            <p class="exercise-instructions">Sort each characteristic to the pricing model it best describes. Tap an item, then tap a zone.</p>
            
            <div class="sort-items" id="items1">
                <div class="sort-item" data-answer="seat" data-id="1">Count named users</div>
                <div class="sort-item" data-answer="seat" data-id="2">Easy to budget annually</div>
                <div class="sort-item" data-answer="seat" data-id="3">Shelfware risk</div>
                <div class="sort-item" data-answer="consumption" data-id="4">Capacity Units</div>
                <div class="sort-item" data-answer="consumption" data-id="5">Pay for actual usage</div>
                <div class="sort-item" data-answer="consumption" data-id="6">Bill shock possible</div>
                <div class="sort-item" data-answer="outcome" data-id="7">Per resolution pricing</div>
                <div class="sort-item" data-answer="outcome" data-id="8">Attribution challenges</div>
                <div class="sort-item" data-answer="outcome" data-id="9">Vendor shares risk</div>
            </div>
            
            <div class="sort-zones" id="zones1">
                <div class="sort-zone seat" data-zone="seat">
                    <div class="sort-zone-title">👤 Seat-Based</div>
                    <div class="sort-zone-items"></div>
                </div>
                <div class="sort-zone consumption" data-zone="consumption">
                    <div class="sort-zone-title">📊 Consumption</div>
                    <div class="sort-zone-items"></div>
                </div>
                <div class="sort-zone outcome" data-zone="outcome">
                    <div class="sort-zone-title">🎯 Outcome</div>
                    <div class="sort-zone-items"></div>
                </div>
            </div>
            <p class="help-text">Tap item → Tap zone to place</p>
            <div class="feedback-box" id="feedback1"></div>
        </div>
        
        <!-- Exercise 2: Match Companies to Pricing Innovation -->
        <div class="exercise" id="exercise2">
            <div class="exercise-header">
                <div>
                    <div class="exercise-number">Exercise 2 of 4</div>
                    <div class="exercise-title">Match the Pricing Innovation</div>
                </div>
                <div class="exercise-points">20 points</div>
            </div>
            <p class="exercise-instructions">Match each company to their pricing innovation:</p>
            
            <div class="match-container" id="matches">
                <div class="match-row">
                    <div class="match-left">SAP (HANA/Datasphere)</div>
                    <div class="match-arrow">→</div>
                    <select class="match-select" data-answer="cu">
                        <option value="">Select...</option>
                        <option value="results">Pay for Results</option>
                        <option value="conv">Per-Conversation</option>
                        <option value="cu">Capacity Units</option>
                        <option value="ar">Automated Resolutions</option>
                    </select>
                </div>
                <div class="match-row">
                    <div class="match-left">Zendesk (AI Agents)</div>
                    <div class="match-arrow">→</div>
                    <select class="match-select" data-answer="ar">
                        <option value="">Select...</option>
                        <option value="conv">Per-Conversation</option>
                        <option value="ar">Automated Resolutions</option>
                        <option value="results">Pay for Results</option>
                        <option value="cu">Capacity Units</option>
                    </select>
                </div>
                <div class="match-row">
                    <div class="match-left">Salesforce Agentforce</div>
                    <div class="match-arrow">→</div>
                    <select class="match-select" data-answer="conv">
                        <option value="">Select...</option>
                        <option value="ar">Automated Resolutions</option>
                        <option value="cu">Capacity Units</option>
                        <option value="conv">Per-Conversation</option>
                        <option value="results">Pay for Results</option>
                    </select>
                </div>
                <div class="match-row">
                    <div class="match-left">Sierra AI</div>
                    <div class="match-arrow">→</div>
                    <select class="match-select" data-answer="results">
                        <option value="">Select...</option>
                        <option value="cu">Capacity Units</option>
                        <option value="results">Pay for Results</option>
                        <option value="ar">Automated Resolutions</option>
                        <option value="conv">Per-Conversation</option>
                    </select>
                </div>
            </div>
            <div class="feedback-box" id="feedback2"></div>
        </div>
        
        <!-- Exercise 3: PMM Role Sorting -->
        <div class="exercise" id="exercise3">
            <div class="exercise-header">
                <div>
                    <div class="exercise-number">Exercise 3 of 4</div>
                    <div class="exercise-title">PMM vs. Not PMM Responsibilities</div>
                </div>
                <div class="exercise-points">24 points</div>
            </div>
            <p class="exercise-instructions">At SAP, which of these are PMM/Solution Manager responsibilities in pricing strategy?</p>
            
            <div class="sort-items" id="items3">
                <div class="sort-item" data-answer="pmm" data-id="a">Value articulation</div>
                <div class="sort-item" data-answer="pmm" data-id="b">ROI calculators</div>
                <div class="sort-item" data-answer="pmm" data-id="c">Competitive positioning</div>
                <div class="sort-item" data-answer="pmm" data-id="d">Pricing strategy (with CS)</div>
                <div class="sort-item" data-answer="pmm" data-id="e">Deal discount approval</div>
                <div class="sort-item" data-answer="notpmm" data-id="f">Negotiating contracts</div>
            </div>
            
            <div class="sort-zones two-col" id="zones3">
                <div class="sort-zone consumption" data-zone="pmm">
                    <div class="sort-zone-title">✅ PMM/Solution Mgr</div>
                    <div class="sort-zone-items"></div>
                </div>
                <div class="sort-zone seat" data-zone="notpmm">
                    <div class="sort-zone-title">❌ Not PMM</div>
                    <div class="sort-zone-items"></div>
                </div>
            </div>
            <p class="help-text">Tap item → Tap zone to place</p>
            <div class="feedback-box" id="feedback3"></div>
        </div>
        
        <!-- Exercise 4: Scenario -->
        <div class="exercise" id="exercise4">
            <div class="exercise-header">
                <div>
                    <div class="exercise-number">Exercise 4 of 4</div>
                    <div class="exercise-title">Pricing Scenario</div>
                </div>
                <div class="exercise-points">26 points</div>
            </div>
            
            <div class="scenario-box">
                <h4>📋 Scenario</h4>
                <p>A prospect asks: "We're evaluating SAP Datasphere vs. a competitor that charges per-user. How do I explain your Capacity Unit model to our CFO who wants predictable costs?"</p>
                <p style="margin-top:0.75rem;"><strong>As the PMM, what's the best approach?</strong></p>
            </div>
            
            <div class="options" id="scenario1">
                <label class="option" data-value="a">
                    <input type="radio" name="scenario1" value="a">
                    <span class="option-marker">A</span>
                    <span class="option-text">Tell them per-user pricing is outdated and they should embrace consumption-based models.</span>
                </label>
                <label class="option" data-value="b">
                    <input type="radio" name="scenario1" value="b">
                    <span class="option-marker">B</span>
                    <span class="option-text">Explain that SAP offers committed capacity options — buy a block of CUs upfront at a discount for budget predictability, with flexibility to allocate across services.</span>
                </label>
                <label class="option" data-value="c">
                    <input type="radio" name="scenario1" value="c">
                    <span class="option-marker">C</span>
                    <span class="option-text">Recommend they go with the per-user competitor if predictable costs are important.</span>
                </label>
                <label class="option" data-value="d">
                    <input type="radio" name="scenario1" value="d">
                    <span class="option-marker">D</span>
                    <span class="option-text">Focus only on the technology features and avoid discussing pricing details.</span>
                </label>
            </div>
            <div class="feedback-box" id="feedback4a"></div>
            
            <div class="scenario-box" style="margin-top: 2rem;">
                <h4>📋 Scenario 2</h4>
                <p>Your sales team keeps losing deals because prospects say "your pricing is confusing." What should PMM do?</p>
            </div>
            
            <div class="options" id="scenario2">
                <label class="option" data-value="a">
                    <input type="radio" name="scenario2" value="a">
                    <span class="option-marker">A</span>
                    <span class="option-text">Ask product to simplify the pricing model.</span>
                </label>
                <label class="option" data-value="b">
                    <input type="radio" name="scenario2" value="b">
                    <span class="option-marker">B</span>
                    <span class="option-text">Create value translation tools — calculators, TCO comparisons, and simple analogies that help sales explain "what you get for your investment."</span>
                </label>
                <label class="option" data-value="c">
                    <input type="radio" name="scenario2" value="c">
                    <span class="option-marker">C</span>
                    <span class="option-text">Train sales to redirect pricing questions to the finance team.</span>
                </label>
                <label class="option" data-value="d">
                    <input type="radio" name="scenario2" value="d">
                    <span class="option-marker">D</span>
                    <span class="option-text">Focus on winning technical evaluations instead of pricing discussions.</span>
                </label>
            </div>
            <div class="feedback-box" id="feedback4b"></div>
        </div>
        
        <div class="submit-section">
            <button class="submit-btn" id="submitBtn">Submit Assessment</button>
        </div>
        
        <div class="results-container" id="resultsContainer">
            <div class="results-header" id="resultsHeader">
                <div class="results-score" id="resultsScore">0%</div>
                <div class="results-message" id="resultsMessage"></div>
                <div class="results-detail" id="resultsDetail"></div>
            </div>
            
            <div class="results-breakdown">
                <h3>Score Breakdown</h3>
                <div class="breakdown-row">
                    <span class="breakdown-label">Exercise 1: Pricing Characteristics (9 items)</span>
                    <span class="breakdown-score" id="score1">0/30</span>
                </div>
                <div class="breakdown-row">
                    <span class="breakdown-label">Exercise 2: Company Matching (4 items)</span>
                    <span class="breakdown-score" id="score2">0/20</span>
                </div>
                <div class="breakdown-row">
                    <span class="breakdown-label">Exercise 3: PMM Responsibilities (6 items)</span>
                    <span class="breakdown-score" id="score3">0/24</span>
                </div>
                <div class="breakdown-row">
                    <span class="breakdown-label">Exercise 4: Scenarios (2 questions)</span>
                    <span class="breakdown-score" id="score4">0/26</span>
                </div>
            </div>
            
            <div class="next-steps" id="nextSteps">
                <h3 id="nextStepsTitle"></h3>
                <div id="nextStepsContent"></div>
            </div>
        </div>
    </main>

<script>
// Sorting logic
let selectedItem = null;

document.querySelectorAll('.sort-item').forEach(item => {
    item.addEventListener('click', function() {
        if (this.classList.contains('placed')) return;
        
        document.querySelectorAll('.sort-item').forEach(i => i.classList.remove('selected'));
        this.classList.add('selected');
        selectedItem = this;
    });
});

document.querySelectorAll('.sort-zone').forEach(zone => {
    zone.addEventListener('click', function() {
        if (!selectedItem) return;
        
        const zoneItems = this.querySelector('.sort-zone-items');
        const clone = selectedItem.cloneNode(true);
        clone.classList.remove('selected');
        clone.classList.add('placed');
        clone.addEventListener('click', function() {
            this.remove();
            const original = document.querySelector(`.sort-item[data-id="${this.dataset.id}"]`);
            if (original) original.classList.remove('placed');
        });
        
        zoneItems.appendChild(clone);
        selectedItem.classList.add('placed');
        selectedItem.classList.remove('selected');
        selectedItem = null;
    });
});

// Option selection
document.querySelectorAll('.option').forEach(option => {
    option.addEventListener('click', function() {
        const name = this.querySelector('input').name;
        document.querySelectorAll(`input[name="${name}"]`).forEach(input => {
            input.closest('.option').classList.remove('selected');
        });
        this.classList.add('selected');
        this.querySelector('input').checked = true;
    });
});

// Submit
document.getElementById('submitBtn').addEventListener('click', function() {
    let totalScore = 0;
    const scores = { ex1: 0, ex2: 0, ex3: 0, ex4: 0 };
    
    // Exercise 1: Sorting (30 pts, ~3.33 each)
    document.querySelectorAll('#zones1 .sort-zone-items .sort-item').forEach(item => {
        const zone = item.closest('.sort-zone').dataset.zone;
        if (item.dataset.answer === zone) scores.ex1 += 3.33;
    });
    scores.ex1 = Math.round(scores.ex1);
    
    // Exercise 2: Matching (20 pts, 5 each)
    document.querySelectorAll('.match-select').forEach(select => {
        const isCorrect = select.value === select.dataset.answer;
        select.classList.remove('correct', 'incorrect');
        select.classList.add(isCorrect ? 'correct' : 'incorrect');
        if (isCorrect) scores.ex2 += 5;
    });
    
    // Exercise 3: PMM sorting (24 pts, 4 each)
    document.querySelectorAll('#zones3 .sort-zone-items .sort-item').forEach(item => {
        const zone = item.closest('.sort-zone').dataset.zone;
        if (item.dataset.answer === zone) scores.ex3 += 4;
    });
    
    // Exercise 4: Scenarios (26 pts, 13 each)
    const s1 = document.querySelector('input[name="scenario1"]:checked');
    const s2 = document.querySelector('input[name="scenario2"]:checked');
    
    document.querySelectorAll('#scenario1 .option, #scenario2 .option').forEach(opt => {
        opt.classList.remove('correct', 'incorrect');
    });
    
    if (s1) {
        const opt = s1.closest('.option');
        if (s1.value === 'b') {
            scores.ex4 += 13;
            opt.classList.add('correct');
            document.getElementById('feedback4a').innerHTML = '✅ Correct! Committed capacity options give CFOs budget predictability while maintaining consumption flexibility.';
            document.getElementById('feedback4a').className = 'feedback-box show correct';
        } else {
            opt.classList.add('incorrect');
            document.querySelector('#scenario1 .option[data-value="b"]').classList.add('correct');
            document.getElementById('feedback4a').innerHTML = '❌ The best approach is explaining committed capacity options — they provide budget predictability with usage flexibility.';
            document.getElementById('feedback4a').className = 'feedback-box show incorrect';
        }
    }
    
    if (s2) {
        const opt = s2.closest('.option');
        if (s2.value === 'b') {
            scores.ex4 += 13;
            opt.classList.add('correct');
            document.getElementById('feedback4b').innerHTML = '✅ Correct! PMMs own value translation — making abstract pricing models understandable through calculators, comparisons, and simple narratives.';
            document.getElementById('feedback4b').className = 'feedback-box show correct';
        } else {
            opt.classList.add('incorrect');
            document.querySelector('#scenario2 .option[data-value="b"]').classList.add('correct');
            document.getElementById('feedback4b').innerHTML = '❌ PMMs should create value translation tools — that\'s our job, not asking product to change pricing or deflecting to finance.';
            document.getElementById('feedback4b').className = 'feedback-box show incorrect';
        }
    }
    
    totalScore = scores.ex1 + scores.ex2 + scores.ex3 + scores.ex4;
    const passed = totalScore >= 80;
    
    // Show sorting feedback
    ['1', '3'].forEach(exNum => {
        const fb = document.getElementById(`feedback${exNum}`);
        const zoneId = exNum === '1' ? 'zones1' : 'zones3';
        let correct = 0;
        document.querySelectorAll(`#${zoneId} .sort-zone-items .sort-item`).forEach(item => {
            const zone = item.closest('.sort-zone').dataset.zone;
            if (item.dataset.answer === zone) correct++;
        });
        const total = document.querySelectorAll(`#items${exNum} .sort-item`).length;
        fb.innerHTML = `${correct}/${total} items placed correctly`;
        fb.className = `feedback-box show ${correct === total ? 'correct' : 'incorrect'}`;
    });
    
    // Matching feedback
    const matchFb = document.getElementById('feedback2');
    const matchCorrect = document.querySelectorAll('.match-select.correct').length;
    matchFb.innerHTML = `${matchCorrect}/4 matches correct`;
    matchFb.className = `feedback-box show ${matchCorrect === 4 ? 'correct' : 'incorrect'}`;
    
    // Display results
    document.getElementById('resultsScore').textContent = `${totalScore}%`;
    document.getElementById('resultsHeader').className = `results-header ${passed ? 'pass' : 'fail'}`;
    document.getElementById('resultsMessage').textContent = passed ? '🎉 Pricing Master!' : 'Keep Learning!';
    document.getElementById('resultsDetail').textContent = passed 
        ? 'You understand pricing models and PMM\'s role in value articulation.'
        : 'Review the unit content and try again.';
    
    document.getElementById('score1').textContent = `${scores.ex1}/30`;
    document.getElementById('score1').className = `breakdown-score ${scores.ex1 >= 27 ? 'full' : scores.ex1 > 0 ? 'partial' : 'zero'}`;
    document.getElementById('score2').textContent = `${scores.ex2}/20`;
    document.getElementById('score2').className = `breakdown-score ${scores.ex2 === 20 ? 'full' : scores.ex2 > 0 ? 'partial' : 'zero'}`;
    document.getElementById('score3').textContent = `${scores.ex3}/24`;
    document.getElementById('score3').className = `breakdown-score ${scores.ex3 === 24 ? 'full' : scores.ex3 > 0 ? 'partial' : 'zero'}`;
    document.getElementById('score4').textContent = `${scores.ex4}/26`;
    document.getElementById('score4').className = `breakdown-score ${scores.ex4 === 26 ? 'full' : scores.ex4 > 0 ? 'partial' : 'zero'}`;
    
    document.getElementById('nextStepsTitle').textContent = passed ? 'Congratulations!' : 'Not quite there yet';
    document.getElementById('nextStepsContent').innerHTML = passed
        ? `<p>You've mastered pricing and packaging concepts!</p>
           <a href="/curriculum/" class="next-btn primary">Back to Curriculum</a>
           <a href="/curriculum/labs/pricing-rationale.html" class="next-btn secondary">Try the Pricing Lab</a>`
        : `<p>Review the pricing concepts and try again.</p>
           <a href="index.html" class="next-btn secondary">Review Unit 8</a>
           <a href="javascript:location.reload()" class="next-btn primary">Retry Assessment</a>`;
    
    document.getElementById('resultsContainer').classList.add('show');
    document.getElementById('submitBtn').disabled = true;
    
    // Save score
    saveScore(totalScore);
    
    document.getElementById('resultsContainer').scrollIntoView({ behavior: 'smooth' });
});

async function saveScore(percentage) {
    try {
        let email = null;
        try {
            const directUser = localStorage.getItem('pmm_direct_user');
            if (directUser) {
                email = JSON.parse(directUser).email;
            }
        } catch (e) {}
        
        if (email) {
            console.log('Saving quiz score for unit-08...');
            const res = await fetch('/.netlify/functions/save-result', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    type: 'quiz_score',
                    email: email,
                    data: { chapter: 'unit-08', score: percentage, total: 100, percentage }
                })
            });
            const result = await res.json();
            if (result.error) {
                console.error('Quiz save error:', result.error);
            } else {
                console.log('Quiz score saved successfully');
            }
        }
    } catch (error) {
        console.error('Failed to save score:', error);
    }
}
</script>
    <script src="/assets/js/nav-dropdown.js" defer></script>
</body>
</html>
